{
  "StartAt": "Set In Progress",
  "States": {
    "Set In Progress": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": {
            "S.$": "States.Format('{}#{}', $.tenantId, $.episodeId)"
          },
          "sk": {
            "S.$": "States.Format('data#clip#{}', $.clipId)"
          }
        },
        "UpdateExpression": "SET #statusHistory = list_append(if_not_exists(#statusHistory, :emptyList), :newStatus), #status = :status, #updatedAt = :updatedAt",
        "ExpressionAttributeNames": {
          "#statusHistory": "statusHistory",
          "#status": "status",
          "#updatedAt": "updatedAt"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "Processing"
          },
          ":newStatus": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "Processing"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  },
                  "segmentCount": {
                    "N.$": "States.Format('{}', States.ArrayLength($.segments))"
                  }
                }
              }
            ]
          },
          ":updatedAt": {
            "S.$": "$$.State.EnteredTime"
          },
          ":emptyList": {
            "L": []
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ServiceException",
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Error Handler"
        }
      ],
      "Next": "Iterate Segments",
      "ResultPath": null
    },
    "Iterate Segments": {
      "Type": "Map",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Check Segment Exists",
        "States": {
          "Check Segment Exists": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:getItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Key": {
                "pk": {
                  "S.$": "States.Format('{}#{}', $$.Execution.Input.tenantId, $$.Execution.Input.episodeId)"
                },
                "sk": {
                  "S.$": "States.Format('segment#{}#{}', $$.Execution.Input.clipId, $.order)"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ServiceException",
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "Segment Error Handler"
              }
            ],
            "Next": "Segment Exists Choice",
            "ResultPath": "$.existingSegment"
          },
          "Segment Exists Choice": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.existingSegment.Item",
                "IsPresent": true,
                "Next": "Return Existing Segment"
              }
            ],
            "Default": "Create Segment Record"
          },
          "Return Existing Segment": {
            "Type": "Pass",
            "Parameters": {
              "order.$": "$.existingSegment.Item.order.N",
              "s3Key.$": "$.existingSegment.Item.s3Key.S",
              "duration.$": "$.existingSegment.Item.duration.N",
              "startTime.$": "$.existingSegment.Item.startTime.S",
              "endTime.$": "$.existingSegment.Item.endTime.S",
              "status": "existing"
            },
            "End": true
          },
          "Create Segment Record": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:putItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Item": {
                "pk": {
                  "S.$": "States.Format('{}#{}', $$.Execution.Input.tenantId, $$.Execution.Input.episodeId)"
                },
                "sk": {
                  "S.$": "States.Format('segment#{}#{}', $$.Execution.Input.clipId, $.order)"
                },
                "order": {
                  "N.$": "States.Format('{}', $.order)"
                },
                "clipId": {
                  "S.$": "$$.Execution.Input.clipId"
                },
                "startTime": {
                  "S.$": "$.startTime"
                },
                "endTime": {
                  "S.$": "$.endTime"
                },
                "status": {
                  "S": "Processing"
                },
                "createdAt": {
                  "S.$": "$$.State.EnteredTime"
                },
                "updatedAt": {
                  "S.$": "$$.State.EnteredTime"
                }
              },
              "ConditionExpression": "attribute_not_exists(pk) AND attribute_not_exists(sk)"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ServiceException",
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              },
              {
                "ErrorEquals": [
                  "DynamoDB.ConditionalCheckFailedException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 2,
                "BackoffRate": 1.5,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "DynamoDB.ConditionalCheckFailedException"
                ],
                "Next": "Check Segment Exists"
              },
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "Segment Error Handler"
              }
            ],
            "Next": "Extract and store segment",
            "ResultPath": "$.segmentRecord"
          },
          "Extract and store segment": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "OutputPath": "$.Payload",
            "Parameters": {
              "FunctionName": "${SegmentExtractor}",
              "Payload": {
                "tenantId.$": "$$.Execution.Input.tenantId",
                "episodeId.$": "$$.Execution.Input.episodeId",
                "clipId.$": "$$.Execution.Input.clipId",
                "order.$": "$.order",
                "segment": {
                  "startTime.$": "$.startTime",
                  "endTime.$": "$.endTime",
                  "speaker.$": "$.speaker",
                  "order.$": "$.order"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "Segment Error Handler"
              }
            ],
            "Next": "Update Segment Complete"
          },
          "Update Segment Complete": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Parameters": {
              "TableName": "${TableName}",
              "Key": {
                "pk": {
                  "S.$": "States.Format('{}#{}', $$.Execution.Input.tenantId, $$.Execution.Input.episodeId)"
                },
                "sk": {
                  "S.$": "States.Format('segment#{}#{}', $$.Execution.Input.clipId, $.order)"
                }
              },
              "UpdateExpression": "SET #status = :status, #s3Key = :s3Key, #duration = :duration, #updatedAt = :updatedAt",
              "ExpressionAttributeNames": {
                "#status": "status",
                "#s3Key": "s3Key",
                "#duration": "duration",
                "#updatedAt": "updatedAt"
              },
              "ExpressionAttributeValues": {
                ":status": {
                  "S": "completed"
                },
                ":s3Key": {
                  "S.$": "$.segmentFile"
                },
                ":duration": {
                  "N.$": "States.Format('{}', $.metadata.duration)"
                },
                ":updatedAt": {
                  "S.$": "$$.State.EnteredTime"
                }
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "DynamoDB.ServiceException",
                  "DynamoDB.ProvisionedThroughputExceededException",
                  "DynamoDB.ThrottlingException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "Segment Error Handler"
              }
            ],
            "ResultPath": null,
            "End": true
          },
          "Segment Error Handler": {
            "Type": "Pass",
            "Parameters": {
              "status": "Failed",
              "error": {
                "message": "Segment extraction failed",
                "timestamp.$": "$$.State.EnteredTime",
                "segmentData.$": "$"
              }
            },
            "End": true
          }
        }
      },
      "ItemsPath": "$.segments",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Error Handler"
        }
      ],
      "Next": "Update Segments Complete Status",
      "ResultPath": "$.generated"
    },
    "Update Segments Complete Status": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": {
            "S.$": "States.Format('{}#{}', $$.Execution.Input.tenantId, $$.Execution.Input.episodeId)"
          },
          "sk": {
            "S.$": "States.Format('data#clip#{}', $$.Execution.Input.clipId)"
          }
        },
        "UpdateExpression": "SET #statusHistory = list_append(#statusHistory, :newStatus), #updatedAt = :updatedAt",
        "ExpressionAttributeNames": {
          "#statusHistory": "statusHistory",
          "#updatedAt": "updatedAt"
        },
        "ExpressionAttributeValues": {
          ":newStatus": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "Processing"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  },
                  "segmentCount": {
                    "N.$": "States.Format('{}', States.ArrayLength($.generated))"
                  },
                  "processingStep": {
                    "S": "segment_extraction_complete"
                  }
                }
              }
            ]
          },
          ":updatedAt": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ServiceException",
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Error Handler"
        }
      ],
      "Next": "Compose Clip From Segments",
      "ResultPath": null
    },
    "Compose Clip From Segments": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "${ClipStitcher}",
        "Payload": {
          "tenantId.$": "$$.Execution.Input.tenantId",
          "episodeId.$": "$$.Execution.Input.episodeId",
          "clipId.$": "$$.Execution.Input.clipId",
          "segments.$": "$.generated"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Error Handler"
        }
      ],
      "Next": "Set Complete"
    },
    "Set Complete": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": {
            "S.$": "States.Format('{}#{}', $$.Execution.Input.tenantId, $$.Execution.Input.episodeId)"
          },
          "sk": {
            "S.$": "States.Format('data#clip#{}', $$.Execution.Input.clipId)"
          }
        },
        "UpdateExpression": "SET #statusHistory = list_append(#statusHistory, :newStatus), #status = :status, #updatedAt = :updatedAt, #s3Key = :s3Key, #duration = :duration",
        "ExpressionAttributeNames": {
          "#statusHistory": "statusHistory",
          "#status": "status",
          "#updatedAt": "updatedAt",
          "#s3Key": "s3Key",
          "#duration": "duration"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "Created"
          },
          ":newStatus": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "Created"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  }
                }
              }
            ]
          },
          ":updatedAt": {
            "S.$": "$$.State.EnteredTime"
          },
          ":s3Key": {
            "S.$": "$.clipS3Key"
          },
          ":duration": {
            "S.$": "$.duration"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ServiceException",
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Error Handler"
        }
      ],
      "Next": "Publish Notification Event"
    },
    "Publish Notification Event": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "Source": "nullcheck",
            "DetailType": "Notification",
            "Detail": {
              "type": "clip_processed",
              "tenantId.$": "$$.Execution.Input.tenantId",
              "userId": null,
              "title": "Clip Ready",
              "message": "Your clip has been processed",
              "url.$": "States.Format('/episodes/{}/clips/{}', $$.Execution.Input.episodeId, $$.Execution.Input.clipId)",
              "persist": false,
              "topic": "tasks",
              "metadata": {
                "episodeId.$": "$.episodeId",
                "clipId.$": "$.clipId"
              }
            }
          }
        ]
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Events.ServiceException",
            "Events.ThrottlingException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    },
    "Error Handler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${TableName}",
        "Key": {
          "pk": {
            "S.$": "States.Format('{}#{}', $$.Execution.Input.tenantId, $$.Execution.Input.episodeId)"
          },
          "sk": {
            "S.$": "States.Format('data#clip#{}', $$.Execution.Input.clipId)"
          }
        },
        "UpdateExpression": "SET #statusHistory = list_append(if_not_exists(#statusHistory, :emptyList), :failureStatus), #status = :status, #updatedAt = :updatedAt",
        "ExpressionAttributeNames": {
          "#statusHistory": "statusHistory",
          "#status": "status",
          "#updatedAt": "updatedAt"
        },
        "ExpressionAttributeValues": {
          ":status": {
            "S": "Failed"
          },
          ":failureStatus": {
            "L": [
              {
                "M": {
                  "status": {
                    "S": "Failed"
                  },
                  "timestamp": {
                    "S.$": "$$.State.EnteredTime"
                  }
                }
              }
            ]
          },
          ":updatedAt": {
            "S.$": "$$.State.EnteredTime"
          },
          ":emptyList": {
            "L": []
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ServiceException",
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.ThrottlingException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Final Error State"
        }
      ],
      "Next": "Notify Failure"
    },
    "Final Error State": {
      "Type": "Pass",
      "Parameters": {
        "status": "Failed",
        "message": "Critical error: Unable to update clip status in database",
        "timestamp.$": "$$.State.EnteredTime"
      },
      "Next": "Notify Failure"
    },
    "Notify Failure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ClipGenerationFailedFunctionArn}",
        "Payload": {
          "tenantId.$": "$.Execution.Input.tenantId",
          "episodeId.$": "$.Execution.Input.episodeId",
          "clipId.$": "$.Execution.Input.clipId",
          "error": {
            "message": "Clip generation failed"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Fail State"
        }
      ],
      "ResultPath": null,
      "Next": "Fail State"
    },
    "Fail State": {
      "Type": "Fail",
      "Cause": "Clip generation workflow failed",
      "Error": "ClipGenerationError"
    }
  }
}
